# Optional overrides for the helper scripts.
# Copy to .env and edit if you need custom locations or ports.

AW_INSTALL_DIR="$HOME/.local/opt/activitywatch"
AW_BASE_URL="http://127.0.0.1:5600"
AW_ENHANCED_HOST="127.0.0.1"
AW_ENHANCED_PORT="8712"
AW_REPORTS_DIR="$HOME/ActivityWatchReports"

# Optional overrides for macOS / Windows when auto-detection is not enough.
# AW_MACOS_APP="/Applications/ActivityWatch.app"
# AW_WINDOWS_EXE="C:\\Users\\<you>\\AppData\\Local\\Programs\\ActivityWatch\\ActivityWatch.exe"
